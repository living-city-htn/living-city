# Copy to .env.local. Never commit .env.local.

# AI provider (Call A and Call B). Needs billing enabled.
# OpenAI is the single critical-path provider: integration/EVENT-FACTS.md
# decision 3. Gemini is built and kept as the documented alternate; set
# AI_PROVIDER=gemini and fill GEMINI_API_KEY to switch. Nothing fails over
# automatically - the stage-time fuse is the operator's preset plan button.
OPENAI_API_KEY=
AI_PROVIDER=openai
GEMINI_API_KEY=

# Postgres connection string
DATABASE_URL=

# Vercel Blob, for post image upload
BLOB_READ_WRITE_TOKEN=

# 1 = serve fixtures instead of calling the real pipeline. Default for local dev.
# Set to 0 (with a key above) to run Call A inline on new posts and Call B on tick.
USE_FIXTURES=1

# Which city's data to load
CITY_ID=kw

# ---------------------------------------------------------------------------
# Pipeline. Everything below has a working default; set one only to change it.
# packages/pipeline/src/env.ts is the full list.
# ---------------------------------------------------------------------------

# Call A is high volume and short (small tier). Call B runs rarely and needs
# better judgement on the identity-versus-spike rules (full tier). docs/03
# section 9. Deterministic tiers on purpose: the reasoning tiers reject
# temperature 0 and spend the output budget on reasoning tokens, which breaks
# the replay set (docs/03 principle 7).
OPENAI_MODEL_CALL_A=gpt-4.1-mini
OPENAI_MODEL_CALL_B=gpt-4.1

# Only read when AI_PROVIDER=gemini.
GEMINI_MODEL_CALL_A=gemini-2.5-flash
GEMINI_MODEL_CALL_B=gemini-2.5-pro

# For a proxy or gateway in front of the OpenAI API. No trailing slash.
OPENAI_BASE_URL=https://api.openai.com/v1

# Timeouts, one retry, and the guard that makes ten judges posting at once queue
# inside the handler instead of failing. docs/04 Stage 3.
AI_TIMEOUT_MS=20000
AI_MAX_ATTEMPTS=2
CALL_A_CONCURRENCY=4

# The city's wall clock, used to build time_context.
CITY_TIMEZONE=America/Toronto

# Where 3D's taxonomy.v1.json lives, if not one of the default paths.
TAXONOMY_PATH=

# Absolute base for resolving root-relative image paths (e.g. the deploy URL).
PUBLIC_BASE_URL=

# --- Moment 4's dial. docs/04 section 2, moment 4. --------------------------
# These decide how few posts it takes for the demo block to visibly change.
# Short half-life means one fresh post outweighs the calm seed posts.
AGG_RECENCY_HALF_LIFE_HOURS=12
AGG_ENGAGEMENT_FACTOR=0.5
AGG_FLAGGED_WEIGHT=0.5
AGG_BASELINE_ALPHA=0.2
AGG_SUFFICIENCY_MEDIUM=6
AGG_SUFFICIENCY_HIGH=30
AGG_SUFFICIENCY_MIN_AUTHORS=3

# ---------------------------------------------------------------------------
# Voice posts (T3). Off by default. With this unset the post form renders no
# record control and nothing below is read, so the app is what it is today.
# ---------------------------------------------------------------------------

# 1 = show the voice note control on the post form.
NEXT_PUBLIC_VOICE_POSTS=0

# 1 = accept and store an attached voice note on the server. Both halves must
# be set: the client one draws the control, this one does the work.
VOICE_POSTS=0

# Audio uses the BLOB_READ_WRITE_TOKEN above. With no token set, clips stay
# inline in the request and nothing is uploaded, which is how the voice path
# runs on venue wifi with no keys. Retention is NOT an env var on purpose:
# apps/web/lib/voice-blob.ts AUDIO_RETENTION is the one place it is decided,
# and it deletes the audio once the transcript is stored.

# Huawei OMNI, the voice perception call. Absent key means every voice post
# degrades to text-only analysis, which is a supported state and not an error,
# so the whole flow still runs at a venue with no connectivity.
OMNI_API_KEY=
OMNI_BASE_URL=https://api.huaweicloud.com/v1
OMNI_MODEL=omni-multimodal
# Shorter than Call A's timeout on purpose: a voice post waits for OMNI and
# then for Call A, so this is latency a judge stands through.
OMNI_TIMEOUT_MS=8000
OMNI_MAX_ATTEMPTS=2

# ---------------------------------------------------------------------------
# Authenticity gate (T3, GPTZero). Off by default. ADVISORY ONLY: it labels,
# weights and sorts. It never blocks, delays, hides, deletes or replans, and a
# failure of any kind produces a null score that means "no opinion".
# ---------------------------------------------------------------------------
AUTHENTICITY_GATE=0
GPTZERO_API_KEY=
GPTZERO_BASE_URL=https://api.gptzero.me/v2
# Shorter than Call A on purpose. The gate races Call A and is abandoned the
# moment Call A finishes, so this is an upper bound and not added latency.
AUTHENTICITY_TIMEOUT_MS=4000

# 1 = answer the voice call from packages/fixtures/data/voice instead of the
# network. Read only when OMNI_API_KEY is empty, so it cannot shadow a real
# call. This is how the voice path is rehearsed on venue wifi.
VOICE_FIXTURES=0
